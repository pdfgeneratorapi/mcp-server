# Server configuration
PORT=3000
LOG_LEVEL=info

# API Base URL
API_BASE_URL=https://us1.pdfgeneratorapi.com/api/v4

# Bearer token (stdio mode only)
# In HTTP mode, pass the token via "Authorization: Bearer <token>" header per-request
# BEARER_TOKEN_JWT=your-jwt-token-here

# OAuth (HTTP mode only)
# Canonical URI of this MCP server; access tokens must name it as their audience
MCP_RESOURCE_URL=https://mcp.pdfgeneratorapi.com/mcp
# Authorization server that issues the access tokens (no trailing slash)
OAUTH_ISSUER=https://auth.pdfgeneratorapi.com
# Signing keys; discovered from the issuer's metadata when unset (for self-hosted or air-gapped installs)
# OAUTH_JWKS_URI=https://auth.pdfgeneratorapi.com/.well-known/jwks.json

# Session idle timeout in minutes (HTTP mode only)
# SESSION_TTL_MINUTES=30

# CORS allowed origins — comma-separated (HTTP mode only)
# Default is "*" (all origins). Restrict in production:
# CORS_ORIGIN=https://your-app.example.com
